SERVER_ENV=local
SERVER_DEBUG=true
SERVER_HOST=0.0.0.0
SERVER_PORT=9001
SERVER_AUTH_ENABLE=true
SERVER_AUTH_KEY=X-Api-Key
SERVER_AUTH_CACHE_TTL=1800

TIMEZONE=Asia/Shanghai

DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_DEBUG=2
DB_MAX_IDLE_CONNECTIONS=15
DB_MAX_OPEN_CONNECTIONS=30
DB_MAX_LIFE_SECONDS=300

LOG_LEVEL=debug
LOG_TYPE=single
LOG_NAME=/opt/xllogs/AEPlatformAPI/service.log
LOG_MAX_SIZE=60
LOG_MAX_BACKUP=5
LOG_MAX_AGE=30
LOG_COMPRESS=false

